pragma language_version 0.20;

import CompactStandardLibrary;

// ==================== REVISED CORE DATA MODELS & STATE MACHINE ====================

/**
 * Renamed to SalePhase to reflect a registry-based approach.
 * Tracks the progression from initial setup to final settlement.
 */
export enum SalePhase {
  PREPARATION,  // Formerly CREATED
  STAKE_COMMIT, // Formerly COMMIT
  VERIFY_REVEAL, // Formerly REVEAL
  SETTLED,      // Formerly FINALIZED
  TERMINATED    // Formerly CANCELLED
}

// Custom types renamed for domain-specific clarity
export type SealerHash = Bytes<32>;     // Cryptographic commitment
export type ValueToken = Uint<128>;     // Monetary bid value
export type ChronoStamp = Uint<64>;     // Network timestamp
export type StakeAmount = Uint<128>;    // Security deposit
export type AccountKey = Bytes<32>;     // Participant identifier

/**
 * SaleSettings: Replaces AuctionConfig.
 * Defines the parameters for the asset exchange.
 */
export struct SaleSettings {
  beneficiary: AccountKey;  // The asset owner receiving funds
  openingTime: ChronoStamp; // Start of commitment window
  closingTime: ChronoStamp; // End of commitment window
  expiryTime: ChronoStamp;  // Deadline for ZK reveal
  reservePrice: StakeAmount; // Minimum stake required to participate
}